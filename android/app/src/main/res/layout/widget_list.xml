<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:tint="#FF263238"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/header" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Próximos eventos" android:textColor="#E6FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center" android:text="@string/widget_empty"
            android:textColor="#B3FFFFFF" android:textSize="13sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/row0_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_row_background" android:tint="#FF1E6FD9"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <TextView android:id="@+id/row0_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎂" android:textSize="15sp" />
                <TextView android:id="@+id/row0_title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="Evento"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/row0_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12 dias" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/row1_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_row_background" android:tint="#FF1E6FD9"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <TextView android:id="@+id/row1_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎂" android:textSize="15sp" />
                <TextView android:id="@+id/row1_title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="Evento"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/row1_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12 dias" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/row2_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_row_background" android:tint="#FF1E6FD9"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <TextView android:id="@+id/row2_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎂" android:textSize="15sp" />
                <TextView android:id="@+id/row2_title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="Evento"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/row2_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12 dias" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/row3_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_row_background" android:tint="#FF1E6FD9"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <TextView android:id="@+id/row3_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎂" android:textSize="15sp" />
                <TextView android:id="@+id/row3_title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="Evento"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/row3_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12 dias" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
